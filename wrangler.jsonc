// Cloudflare Workers deployment: serves the static build in dist/.
// "single-page-application" returns index.html for unknown paths, so routes
// like /contact and /privacy work on refresh and direct links.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walsallenterpriseltd",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
