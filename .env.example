# Contact form backend. Set ONE of these; leave both empty to use the dev-only
# demo handler (production builds then show an error instead of losing enquiries).

# Web3Forms access key (https://web3forms.com). Public by design: it only lets
# visitors send to the inbox it was created for. Put the live key in .env.production.
VITE_WEB3FORMS_ACCESS_KEY=

# Or: any URL that accepts a JSON POST (Formspree, Getform, your own API).
VITE_CONTACT_ENDPOINT=
